#!/bin/sh
# whatplays (упрощённый v3): арбитр звука + фраза «что играет» → «Играет тест».
# Супервизор: перезапускает скрипт, если тот упал.
case "$1" in
  start)
    pgrep -f 'while :; do /data/opt/bin/whatplays' >/dev/null 2>&1 && exit 0
    setsid /bin/sh -c 'while :; do /data/opt/bin/whatplays.sh >> /tmp/whatplays.err 2>&1; sleep 3; done' >/dev/null 2>&1 </dev/null &
    ;;
  stop)
    for p in $(ps | grep whatplays | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done
    for p in $(ps | grep 'main[d] --cli' | awk '{print $1}'); do kill "$p" 2>/dev/null; done
    killall alice_ipc_mon tcpcat 2>/dev/null
    ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
esac
exit 0
