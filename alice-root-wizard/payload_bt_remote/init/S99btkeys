#!/bin/sh
# S99btkeys — автозапуск BT-стека и слушателей пультов при загрузке станции.
# Вся логика — в /data/opt/bin/bt-listeners-start.sh; здесь только запуск
# с задержкой 25с (ждём вендорский стек: maind/bluealsa/D-Bus раньше нас).
# Отключить автозапуск: mv /etc/init.d/S99btkeys /etc/init.d/S99btkeys.disabled
case "$1" in
  start)
    # уже запущено/запланировано? (обёртка содержит bt-listeners-start в cmdline)
    ps | grep -q "bt-listeners-st[a]rt" && exit 0
    setsid sh -c "sleep 25; sh /data/opt/bin/bt-listeners-start.sh" \
      </dev/null >>/tmp/bt-autostart.log 2>&1 &
    ;;
  stop)
    for p in $(ps | grep -E "btke[y]s-(grab|listener)[.]sh|btrc[v]|bluetooth[d] |bt-listeners-st[a]rt" | awk '{print $1}'); do
      kill -9 $p 2>/dev/null
    done
    killall -9 bluetoothd 2>/dev/null
    ;;
  restart)
    "$0" stop; sleep 2; "$0" start
    ;;
  *)
    echo "использование: $0 start|stop|restart"
    ;;
esac
exit 0
