<?xml version="1.0" encoding="utf-8"?>
<!--
    LMS Custom Repository descriptor for Lyrion Yandex Bridge.
    Живёт в КОРНЕ проекта и пушится в корень репозитория как есть —
    LMS читает его по raw-URL ветки main.

    USERS: Add the raw GitHub URL of this file to:
      LMS Settings -> Plugins -> Additional Repositories
      URL: https://raw.githubusercontent.com/knovash/lyrion-yandex-bridge/main/repo.xml

    MAINTAINERS: When publishing a new version, update sha (sha1sum of zip)
    and url (GitHub release asset URL).
-->
<extensions>
    <details>
        <title lang="EN">Lyrion Yandex Bridge Repository</title>
        <title lang="RU">Репозиторий Lyrion Yandex Bridge</title>
    </details>
    <plugins>
        <plugin
            name="LyrionYandexBridge"
            version="1.8.1"
            target="unix|mac"
            minTarget="8.0"
            maxTarget="*"
            sha="312c520745047cb025737aa630447cb528f5e9ac"
            url="https://github.com/knovash/lyrion-yandex-bridge/releases/download/v1.8.1/lyrion-yandex-bridge-v1.8.1.zip"
            creator="Konstantin"
            email="novash.ki@gmail.com"
        >
            <title lang="EN">Lyrion Yandex Smart Home Bridge</title>
            <title lang="RU">Lyrion Yandex Smart Home Bridge</title>
            <desc lang="EN">Integrate LMS players into Yandex Smart Home. Runs a java client: web setup on port 8888, Yandex OAuth, cloud relay. Java 11+ required.</desc>
            <desc lang="RU">Интеграция плееров в умный дом. Запускает java-клиент: веб-настройки на порту 8888, авторизация Яндекс, облачный транспорт. Требуется Java 11+.</desc>
        </plugin>
    </plugins>
</extensions>
